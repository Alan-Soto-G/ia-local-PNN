# Copiar a .env y ajustar. Las variables EXPO_PUBLIC_ quedan en texto plano dentro del APK: nunca poner secretos.
# Leerlas solo como process.env.EXPO_PUBLIC_X (notación de punto); otra forma no se reemplaza en el bundle.

# Backend RAG del computador administrador (API.md), servido por su punto de acceso Wi-Fi.
# IP fija del punto de acceso de Windows; alternativas: http://rag.home.arpa:8000/api o http://<equipo>.mshome.net:8000/api
EXPO_PUBLIC_BACKEND_URL=http://192.168.137.1:8000/api
