# Copiar a .env y ajustar. Las variables EXPO_PUBLIC_ quedan en texto plano dentro del APK: nunca poner secretos.
# Leerlas solo como process.env.EXPO_PUBLIC_X (notación de punto); otra forma no se reemplaza en el bundle.

# Opción A: backend propio
EXPO_PUBLIC_BACKEND_URL=https://backend-pnn.ejemplo.com

# Opción B: Supabase (PostgreSQL + pgvector + Storage). La anon key es pública; los datos los protegen las reglas RLS.
# EXPO_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
