@startuml logica
title Vista lógica: modelo de dominio del Asistente de interpretación ambiental, versión 1

skinparam backgroundColor #1E3B2F
skinparam defaultFontName Arial
skinparam defaultFontColor white
skinparam titleFontColor white
skinparam shadowing false
skinparam ArrowColor white
skinparam ArrowFontColor white
skinparam ArrowFontSize 11
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60
skinparam package {
  BackgroundColor #24493A
  BorderColor #A9D18E
  FontColor white
}
skinparam class {
  BackgroundColor #2E5E4A
  BorderColor white
  FontColor white
  AttributeFontColor white
  HeaderBackgroundColor #548235
  StereotypeFontColor #C5E0B4
}
hide circle
hide methods

package "Conocimiento (llega en una Carga; se borra al vencer)" {
  class Carga {
    estado (sin_datos, cargando, vigente, vencida)
    cargado en
    expira en (= cargado en + 24 h)
    modelo de embedding
    dimensiones
  }
  class Documento {
    nombre
    versión
    archivo
    páginas
  }
  class Fragmento {
    índice
    página
    texto
    vector (384)
  }
}

package "Uso (nunca sale del teléfono; se borra al vencer)" {
  class Conversacion {
    inicio
  }
  class Mensaje {
    rol
    texto
    banda (ALTA, MEDIA, BAJA)
    estado
    TTFT
  }
  class Cita {
    similitud
  }
}

package "Instalación (viene en el APK; no se borra)" {
  class ModeloLocal {
    tipo (lenguaje, embeddings)
    nombre
    versión
    sha256
    estado
  }
}

Carga "1" -- "0..*" Documento : contiene
Documento "1" *-- "1..*" Fragmento
Conversacion "1" *-- "0..*" Mensaje
Mensaje "1" -- "0..*" Cita : respaldada por
Cita "0..*" -- "1" Fragmento
Carga ..> ModeloLocal : exige el mismo modelo de embedding
@enduml
