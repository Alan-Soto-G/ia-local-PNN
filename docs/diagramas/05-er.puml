@startuml er
title Vista de datos: modelo entidad-relación de la Base local (SQLite + sqlite-vec), versión 1

skinparam backgroundColor #1E3B2F
skinparam defaultFontName Arial
skinparam defaultFontColor white
skinparam titleFontColor white
skinparam shadowing false
skinparam ArrowColor white
skinparam ArrowFontColor white
skinparam ArrowFontSize 11
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60
skinparam package {
  BackgroundColor #24493A
  BorderColor #A9D18E
  FontColor white
}
skinparam class {
  BackgroundColor #2E5E4A
  BorderColor white
  FontColor white
  AttributeFontColor white
  HeaderBackgroundColor #548235
  StereotypeFontColor #C5E0B4
}
hide circle
hide methods
skinparam class<<vector>> {
  BackgroundColor #7F6000
  HeaderBackgroundColor #BF9000
}

package "Conocimiento (CU-01; se borra al vencer)" {
  entity carga {
    * id : INTEGER <<PK, siempre 1>>
    --
    * estado : TEXT  -- sin_datos | vigente | vencida
    cargado_en : TEXT  -- ISO-8601 UTC
    expira_en : TEXT
    modelo_embedding : TEXT
    dimensiones : INTEGER
    total_documentos : INTEGER
    total_fragmentos : INTEGER
    url_backend : TEXT
  }
  entity documento {
    * id : INTEGER <<PK, id del backend>>
    --
    * nombre : TEXT
    * version : INTEGER
    * archivo : TEXT
    paginas : INTEGER
    num_fragmentos : INTEGER
    sha256 : TEXT
    creado_en : TEXT
  }
  entity fragmento {
    * id : INTEGER <<PK, id del backend>>
    --
    * documento_id : INTEGER <<FK>>
    * indice : INTEGER
    * pagina : INTEGER
    * texto : TEXT
    caracteres : INTEGER
  }
  entity vec_fragmento <<vector>> {
    * fragmento_id : INTEGER <<PK, FK>>
    --
    * embedding : float[384]  -- coseno
  }
}

package "Uso (CU-02; nunca sale; se borra al vencer)" {
  entity conversacion {
    * id : TEXT <<PK, UUID>>
    --
    * iniciada_en : TEXT
  }
  entity mensaje {
    * id : TEXT <<PK, UUID>>
    --
    * conversacion_id : TEXT <<FK>>
    * rol : TEXT  -- usuario | asistente
    * texto : TEXT
    banda : TEXT  -- ALTA | MEDIA | BAJA
    * estado : TEXT
    ttft_ms : INTEGER
    * creado_en : TEXT
  }
  entity cita {
    * mensaje_id : TEXT <<PK, FK>>
    * fragmento_id : INTEGER <<PK, FK>>
    --
    * orden : INTEGER
    * similitud : REAL
  }
}

documento ||--|{ fragmento
fragmento ||--|| vec_fragmento
conversacion ||--o{ mensaje
mensaje ||--o{ cita
fragmento ||--o{ cita
@enduml
