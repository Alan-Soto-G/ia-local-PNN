@startuml cu01
title ESC-01: CU-01 Consultar por texto con respuesta en streaming (EAC-01, EAC-02, EAC-05; ADR-004, ADR-010)
skinparam backgroundColor #1E3B2F
skinparam defaultFontName Arial
skinparam defaultFontColor white
skinparam titleFontColor white
skinparam shadowing false
<style>
participant {
  Padding 25
}
</style>
skinparam BoxPadding 10
skinparam wrapWidth 230
skinparam maxMessageSize 230
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign left
skinparam NoteTextAlignment left
skinparam SequenceGroupBodyBackgroundColor transparent
skinparam ArrowColor white
skinparam ArrowFontColor white
skinparam sequence {
  LifeLineBorderColor white
  LifeLineBackgroundColor #548235
  ParticipantBackgroundColor #548235
  ParticipantBorderColor white
  ParticipantFontColor white
  ActorBackgroundColor #548235
  ActorBorderColor white
  ActorFontColor white
  GroupBackgroundColor #2E5E4A
  GroupBorderColor white
  GroupFontColor white
  BoxBackgroundColor #2E5E4A
}
skinparam note {
  BackgroundColor #FFF2CC
  BorderColor #C00000
  FontColor #C00000
}

actor "Guía / Visitante" as U
participant "Chat\n(pantalla)" as UI
participant "Módulo Consulta" as C
participant "Gestor de modelos" as G
participant "Motor de inferencia\n(llama.rn)" as M
participant "Base local\n(SQLite + sqlite-vec)" as DB

U -> UI : escribe "¿Por qué el frailejón tiene hojas peludas?"
UI -> C : consultar(texto, conversación)
C -> DB : guarda el Mensaje del usuario y crea el del asistente en "generando"
C -> G : obtener modelo de lenguaje
alt el modelo no está descargado
  G --> C : ModeloNoDisponible
  C --> UI : "descarga el paquete del asistente" (lleva a CU-05)
else modelo listo (precargado al abrir el chat, ADR-009)
  G --> C : motor listo
end
C -> M : embedding(pregunta)
M --> C : vector
C -> DB : kNN en vec_fragmento + FTS5 en fts_fragmento + protocolos (ADR-010)
DB --> C : top-k fragmentos con similitud

alt ninguna similitud supera el umbral
  C --> UI : "No encontré eso en la información validada del parque" (EAC-05)
  C -> DB : Mensaje "completo" sin citas
else hay contexto
  C -> M : generar(instrucciones + perfil + idioma + fragmentos + historial corto)
  loop por cada token
    M --> C : token
    C --> UI : agrega el token (la UI pinta cada ~50 ms, ADR-004)
  end
  note across : Primer texto visible en ≤ 3 s en el 90% de las consultas, en modo avión: cumple EAC-01 y EAC-02
  opt el usuario toca "detener"
    UI -> C : detener()
    C -> M : stopCompletion()
    C -> DB : Mensaje "detenido" con el texto parcial
  end
  C -> DB : Mensaje "completo" + Citas (fragmento, especie, similitud) + TTFT
  C --> UI : muestra las fuentes citadas
end
@enduml
