@startuml fisica
title Vista física: teléfono Android y computador administrador (RT-04, ADR-011, ADR-012)

skinparam backgroundColor #1E3B2F
skinparam defaultFontName Arial
skinparam defaultFontColor white
skinparam titleFontColor white
skinparam shadowing false
skinparam ArrowColor white
skinparam ArrowFontColor white
skinparam ArrowFontSize 11
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80
skinparam node {
  BackgroundColor #24493A
  BorderColor #A9D18E
  FontColor white
}
skinparam component {
  BackgroundColor #2E5E4A
  BorderColor white
  FontColor white
}
skinparam database {
  BackgroundColor #2E5E4A
  BorderColor white
  FontColor white
}
skinparam folder {
  BackgroundColor #2E5E4A
  BorderColor white
  FontColor white
}

node "Teléfono Android 11+ ARM64" as tel {
  node "Proceso de la app (APK con modelos, ADR-013)" as proc {
    component "App móvil (Hermes)" as app
    component "Motor de inferencia\nllama.rn: LFM2.5-350M + MiniLM" as llm
  }
  node "Almacenamiento interno de la app" as alm {
    database "Base local\nSQLite + sqlite-vec" as db
    folder "modelos/" as mod
  }
  component "Notificaciones e instalador de paquetes\n(servicios de Android)" as sys
}

node "Computador administrador (Windows)" as pc {
  component "Backend RAG\nFastAPI :8000" as api
  database "knowledge.db\nSQLite + sqlite-vec" as kdb
  component "Zona con cobertura inalámbrica móvil\n192.168.137.1" as ap
}

app --> llm : puente nativo
llm --> mod : carga los GGUF
app --> db
app --> sys
api --> kdb
ap --> api
app ..> ap : Wi-Fi del punto de acceso, HTTP\n(solo CU-01, sin Internet)
@enduml
