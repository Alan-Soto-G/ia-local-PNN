@startuml procesos
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
skinparam linetype polyline
skinparam nodesep 70
skinparam ranksep 90
title Vista de procesos: contenedores del Asistente, versión 1 (C4 nivel 2)

Person(usuario, "Visitante / Guía", "Actualiza la información y pregunta por texto")

System_Boundary(sistema, "Asistente de interpretación ambiental (APK Android)") {
  Container(app, "App móvil", "Expo SDK 58, React Native, TypeScript", "Pantallas (Expo Router), casos de uso Actualización, Consulta y Vigencia, Gestor de modelos (ADR-008)")
  Container(llm, "Motor de inferencia", "llama.rn (llama.cpp)", "LFM2.5-350M en streaming y embeddings con MiniLM multilingüe (ADR-004, ADR-014)")
  ContainerDb(db, "Base local", "expo-sqlite + sqlite-vec", "Carga, documentos, fragmentos, vectores, conversaciones y citas (ADR-012)")
  ContainerDb(files, "Archivos locales", "Almacenamiento interno", "Copia de los modelos GGUF que trae el APK (ADR-013)")
}

System_Ext(backend, "Backend RAG", "FastAPI en el computador administrador (API.md)")
System_Ext(notif, "Notificaciones de Android", "expo-notifications")
System_Ext(instalador, "Instalador de paquetes", "Android")

Rel(usuario, app, "Usa", "pantalla táctil")
Rel(app, llm, "Genera y vectoriza", "puente nativo")
Rel(llm, files, "Carga los modelos")
Rel(app, files, "Copia los modelos desde el APK")
Rel(app, db, "Lee y escribe", "SQL")
Rel(app, backend, "GET /health/db, /documents, /documents/{id}/chunks (solo CU-01)", "HTTP, red del punto de acceso")
Rel(app, notif, "Programa y cancela el aviso de vencimiento")
Rel(app, instalador, "Abre el diálogo de desinstalación")
@enduml
