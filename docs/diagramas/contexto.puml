@startuml contexto
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 80
title Contexto del Asistente de interpretación ambiental offline, versión 1 (C4 nivel 1)

Person(visitante, "Visitante / Guía", "Actualiza la información y pregunta por texto")
Person_Ext(admin, "Administrador del computador", "Carga y versiona los PDF validados (RN-01)")

System(sistema, "Asistente de interpretación ambiental", "App Android offline: actualizar información, chat de texto con citas y vigencia de 24 h")

System_Ext(backend, "Backend RAG del computador administrador", "FastAPI + SQLite + sqlite-vec; fragmenta y vectoriza los PDF (API.md)")
System_Ext(notif, "Notificaciones de Android", "En el teléfono")
System_Ext(instalador, "Instalador de paquetes de Android", "En el teléfono")

Lay_R(notif, instalador)

Rel_D(visitante, sistema, "Actualiza la información, pregunta, responde al aviso de vencimiento", "pantalla táctil")
Rel_D(sistema, backend, "Baja documentos, fragmentos y vectores (solo CU-01)", "HTTP en la red del punto de acceso")
Rel_D(sistema, notif, "Programa el aviso de vencimiento (CU-03)", "expo-notifications")
Rel_D(sistema, instalador, "Abre el diálogo de desinstalación si el usuario elige Sí", "expo-intent-launcher")
Rel_U(admin, backend, "Carga PDF", "interfaz web local")
@enduml
