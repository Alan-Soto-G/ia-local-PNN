@startuml desarrollo
title Vista de desarrollo: componentes de la App móvil, versión 1, por paquetes y capas

skinparam backgroundColor #1E3B2F
skinparam defaultFontName Arial
skinparam defaultFontColor white
skinparam titleFontColor white
skinparam shadowing false
skinparam ArrowColor white
skinparam ArrowFontColor white
skinparam ArrowFontSize 11
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 80
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #24493A
  BorderColor #A9D18E
  FontColor white
}
skinparam class {
  BackgroundColor #2E5E4A
  BorderColor white
  FontColor white
  AttributeFontColor white
  HeaderBackgroundColor #548235
  StereotypeFontColor #C5E0B4
}
hide circle
hide methods

package "Pantallas (src/app, src/components, src/hooks)" as P {
  class Inicio
  class Chat
  class "Diálogo de vencimiento" as Dialogo
}

package "Casos de uso (src/aplicacion/casos-uso)" as A {
  class "Módulo Actualización\nCU-01" as MAct
  class "Módulo Consulta\nCU-02" as MCon
  class "Módulo Vigencia\nCU-03" as MVig
  class "Gestor de modelos" as GM
}

package "Puertos (src/aplicacion/puertos)" as Pu {
  class ClienteBackend <<puerto>>
  class RepositorioConocimiento <<puerto>>
  class RepositorioConversaciones <<puerto>>
  class BuscadorVectorial <<puerto>>
  class MotorInferencia <<puerto>>
  class CodificadorTexto <<puerto>>
  class PreparadorModelos <<puerto>>
  class Reloj <<puerto>>
  class Notificador <<puerto>>
  class Desinstalador <<puerto>>
}

package "Adaptadores (src/infraestructura)" as I {
  class "Adaptador HTTP del backend" as AHttp
  class "Adaptador SQLite" as ASql
  class "Adaptador llama.rn" as ALlama
  class "Preparación de modelos" as APrep
  class "Adaptador de notificaciones" as ANot
  class "Adaptador de desinstalación" as ADes
  class "Adaptador de reloj" as ARel
}

package "Librerías y sistema" as L {
  class fetch
  class "expo-sqlite + sqlite-vec" as LSql
  class "llama.rn" as LLlama
  class "expo-asset / expo-file-system / expo-crypto" as LFs
  class "expo-notifications" as LNot
  class "expo-intent-launcher" as LInt
}

Inicio --> MAct
Inicio --> MVig
Chat --> MCon
Chat --> MVig
Dialogo --> MVig

MAct --> MVig
MCon --> MVig
MAct --> GM
MCon --> GM
MVig --> GM

MAct --> ClienteBackend
MAct --> RepositorioConocimiento
MCon --> BuscadorVectorial
MCon --> RepositorioConversaciones
MVig --> Reloj
MVig --> Notificador
MVig --> Desinstalador
MVig --> RepositorioConocimiento
MVig --> RepositorioConversaciones
GM --> MotorInferencia
GM --> CodificadorTexto
GM --> PreparadorModelos

AHttp ..|> ClienteBackend
ASql ..|> RepositorioConocimiento
ASql ..|> RepositorioConversaciones
ASql ..|> BuscadorVectorial
ALlama ..|> MotorInferencia
ALlama ..|> CodificadorTexto
APrep ..|> PreparadorModelos
ANot ..|> Notificador
ADes ..|> Desinstalador
ARel ..|> Reloj

AHttp --> fetch
ASql --> LSql
ALlama --> LLlama
APrep --> LFs
ANot --> LNot
ADes --> LInt
@enduml
